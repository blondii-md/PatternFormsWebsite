---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TileShuffleHero, LEFT_LOGO_START, RIGHT_LOGO_START } from '../components/animations.jsx';

const orgSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "PatternForms",
  "url": "https://pattern-forms-website.vercel.app",
  "logo": "https://pattern-forms-website.vercel.app/favicon.svg",
  "description": "A research-and-design atelier developing the methodology, parts, and IP behind productised construction.",
  "sameAs": [],
};
---

<BaseLayout
  title="PATTERNFORMS — STUDIO.SUPPLY.SYSTEMS"
  description="A research-and-design atelier developing the methodology, parts, and IP behind productised construction. First product line, PatternHouse, in development."
  canonical="https://pattern-forms-website.vercel.app/"
  structuredData={orgSchema}
>

  <!-- HERO -->
  <section class="pf-home-hero">
    <div class="pf-container pf-home-hero-inner">

      <div class="pf-hero-stage">
        <div class="pf-hero-mark-pair">
          <div class="pf-hero-mark">
            <TileShuffleHero size={60} color="#0A0A0A" showGrid={true} logoStart={LEFT_LOGO_START} client:load />
          </div>
          <div class="pf-hero-mark pf-hero-mark--second">
            <TileShuffleHero size={60} color="#0A0A0A" showGrid={true} logoStart={RIGHT_LOGO_START} client:load />
          </div>
        </div>
      </div>

      <div class="pf-hero-foot">
        <p class="pf-eyebrow">00 · WHO WE ARE</p>
        <p class="pf-body pf-hero-body">
          A research-and-design atelier developing the methodology, parts, and IP
          behind productised construction here in Victoria.
        </p>

        <div class="pf-hero-foot-row">
          <p class="pf-body pf-hero-body">
            We are architects and engineers. Our first product line —
            <span style="color: var(--pf-terra);"> PatternHouse </span>
            — is in development.
          </p>

          <div class="pf-subscribe">
            <p class="pf-eyebrow pf-subscribe-label">
              PatternHouse is coming — want to be first through the door?
            </p>
            <form class="pf-subscribe-row" action="https://formsubmit.co/interest@patternforms.au" method="POST">
              <input type="hidden" name="_subject" value="PatternHouse launch interest" />
              <input type="hidden" name="_captcha" value="false" />
              <input
                type="email"
                name="email"
                class="pf-input pf-subscribe-input"
                placeholder="your@email.com"
                aria-label="Email address"
                required
              />
              <button type="submit" class="pf-btn">
                Keep me posted →
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- WHAT WE DO -->
  <section id="what-we-do" class="pf-wwd">
    <div class="pf-container">
      <div class="pf-section-head">
        <p class="pf-eyebrow">01 · WHAT WE DO</p>
      </div>

      <div class="pf-wwd-grid">
        <article class="pf-wwd-col">
          <h3 class="pf-wwd-head">STUDIO</h3>
          <p class="pf-subhead pf-wwd-pillars">
            ARCHITECTURE.<br />ENGINEERING.<br />PROJECTS.
          </p>
          <p class="pf-body">
            We work with clients to design and deliver architecturally vested buildings.
          </p>
          <a href="/studio" class="pf-arrow-link" style="margin-top: auto;">
            More about the Studio <span class="arrow">→</span>
          </a>
        </article>

        <article class="pf-wwd-col">
          <h3 class="pf-wwd-head">SUPPLY</h3>
          <p class="pf-subhead pf-wwd-pillars">
            PROCUREMENT.<br />FABRICATION.<br />MANUFACTURING
          </p>
          <p class="pf-body">We design and supply the parts.</p>
          <a href="/supply" class="pf-arrow-link" style="margin-top: auto;">
            More about Supply <span class="arrow">→</span>
          </a>
        </article>

        <article class="pf-wwd-col">
          <h3 class="pf-wwd-head pf-wwd-head--alt">SYSTEMS</h3>
          <p class="pf-subhead pf-wwd-pillars">
            METHODOLOGY.<br />TOOLS.<br />PRINCIPLES.
          </p>
          <p class="pf-body">Runs through both arms. Sharpens with every version.</p>
          <a href="/system" class="pf-arrow-link" style="margin-top: auto;">
            More about Systems <span class="arrow">→</span>
          </a>
        </article>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .pf-home-hero {
    display: flex;
    flex-direction: column;
  }
  .pf-home-hero-inner {
    position: relative;
    padding-top: 0;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .pf-hero-stage {
    width: 100%;
  }
  .pf-hero-mark-pair {
    display: flex;
    gap: 0;
    width: 100%;
  }
  .pf-hero-mark {
    flex: 1;
    min-width: 0;
  }
  @media (max-width: 768px) {
    .pf-hero-mark--second { display: none; }
  }
  .pf-hero-foot {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 8px;
  }
  .pf-hero-body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--pf-grey-60);
  }
  .pf-hero-foot-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: flex-start;
  }
  @media (max-width: 768px) {
    .pf-hero-foot-row { grid-template-columns: 1fr; gap: 24px; }
  }

  .pf-subscribe {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 4px;
  }
  .pf-subscribe-label {
    font-size: 11px;
    color: var(--pf-grey-60);
  }
  .pf-subscribe-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .pf-subscribe-input {
    width: 190px;
    max-width: 100%;
    height: 32px;
    background: transparent;
    color: var(--pf-ink);
    border: 1px solid var(--pf-grey-30);
    padding: 0 10px;
    font-family: var(--pf-font-body);
    font-size: 12px;
    flex-shrink: 0;
  }
  .pf-subscribe-input:focus { outline: none; border-color: var(--pf-ink); }
  .pf-subscribe .pf-btn {
    height: 32px;
    padding: 0 16px;
    font-size: 10px;
  }
  .pf-wwd { padding: 0; }
  .pf-wwd-grid {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 48px;
  }
  @media (max-width: 900px) {
    .pf-wwd-grid { grid-template-columns: 1fr; gap: 40px; }
  }
  .pf-wwd-col {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .pf-wwd-head {
    font-family: var(--pf-font-display);
    font-weight: 400;
    font-size: 32px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--pf-ink);
    line-height: 1;
    margin: 0;
  }
  .pf-wwd-head--alt { font-size: 28px; }
  .pf-wwd-pillars {
    font-size: 13px;
    color: var(--pf-ink);
    margin: 8px 0;
    line-height: 1.7;
  }
</style>
