---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    slug: "stand-frame-v3",
    titleDisplay: "Stand-frame v3 off the CNC",
    date: "2026-05-12",
    excerpt: "12 parts, four fixings per node, ±1 mm tolerance. The skeleton of the chassis, broken open.",
    tag: "FABRICATION",
  },
  {
    slug: "what-is-a-kit-of-parts",
    titleDisplay: "What is a Kit of Parts, really?",
    date: "2026-04-28",
    excerpt: "A short note on terminology. Kit of Parts ≠ catalogue of parts. The difference matters.",
    tag: "METHODOLOGY",
  },
  {
    slug: "compliance-as-a-feature",
    titleDisplay: "Compliance as a feature, not a tax",
    date: "2026-04-10",
    excerpt: "Treat code compliance the way fabricators treat tolerances: a system constraint that does design work for you.",
    tag: "PRACTICE",
  },
  {
    slug: "modular-versus-systematic",
    titleDisplay: "Modular ≠ Systematic",
    date: "2026-03-22",
    excerpt: "Most 'modular' housing is just prefabricated boxes. Systematic means the system thinks; the box is incidental.",
    tag: "ARGUMENT",
  },
  {
    slug: "drawings-are-specifications",
    titleDisplay: "Drawings are specifications",
    date: "2026-03-04",
    excerpt: "The line between an architectural drawing and a fabrication spec is a fiction.",
    tag: "METHODOLOGY",
  },
  {
    slug: "first-laminated-timber-pour",
    titleDisplay: "First laminated timber chassis off the press",
    date: "2026-02-14",
    excerpt: "Seven layers, glued under hydraulic pressure, cured in 14 hours. The chassis came out a kilo under spec.",
    tag: "FABRICATION",
  },
].sort((a, b) => (a.date < b.date ? 1 : -1));

function formatDate(iso: string) {
  const d = new Date(iso + "T00:00:00");
  return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }).toUpperCase();
}
---

<BaseLayout
  title="Output — PATTERNFORMS"
  description="Workings, prototypes, and conventions posted as we go. Fabrication notes, methodology arguments, and practice writing from the PatternForms atelier."
  canonical="https://pattern-forms-website.vercel.app/blog"
>
  <div class="pf-page">
    <section class="pf-container">

      <div class="pf-section-head" style="padding-bottom: 24px;">
        <p class="pf-eyebrow">06 · OUTPUT</p>
        <p class="pf-lede">
          Workings, prototypes, conventions, and the occasional finished thing.
          Posted as we go.
        </p>
      </div>

      <div class="pf-workings-grid">
        {posts.map(post => (
          <a href={`/blog/${post.slug}`} class="pf-blog-card">
            <div class="pf-blog-tag">{post.tag}</div>
            <h3 class="pf-blog-title">{post.titleDisplay}</h3>
            <p class="pf-blog-excerpt">{post.excerpt}</p>
            <div class="pf-blog-foot">
              <span class="pf-blog-date">{formatDate(post.date)}</span>
              <span class="pf-blog-readmore">READ →</span>
            </div>
          </a>
        ))}
      </div>

    </section>
  </div>
</BaseLayout>

<style>
  .pf-workings-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 1024px) {
    .pf-workings-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .pf-workings-grid { grid-template-columns: 1fr; gap: 16px; }
  }
  .pf-blog-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    color: var(--pf-ink);
    padding: 0 0 32px;
    text-decoration: none;
  }
  .pf-blog-tag {
    font-family: var(--pf-font-body);
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--pf-grey-60);
  }
  .pf-blog-title {
    font-family: var(--pf-font-display);
    font-weight: 700;
    font-size: 18px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    margin: 0;
    color: var(--pf-ink);
    transition: color 240ms var(--pf-ease-snap);
  }
  .pf-blog-card:hover .pf-blog-title { color: var(--pf-terra); }
  .pf-blog-excerpt {
    font-family: var(--pf-font-body);
    font-size: 13px;
    line-height: 1.55;
    color: var(--pf-grey-60);
    margin: 0;
  }
  .pf-blog-foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: auto;
    padding-top: 8px;
  }
  .pf-blog-date {
    font-family: var(--pf-font-body);
    font-size: 11px;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--pf-grey-60);
  }
  .pf-blog-readmore {
    font-family: var(--pf-font-display);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--pf-ink);
    transition: color 240ms var(--pf-ease-snap);
  }
  .pf-blog-card:hover .pf-blog-readmore { color: var(--pf-terra); }
</style>
